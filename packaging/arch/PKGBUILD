# Maintainer: Miflow13 <pizzafan513 at gmail dot com>
pkgbase=keyflip
pkgname=keyflip
pkgver=0.2.0_beta
pkgrel=1
pkgdesc="Toggle a supported laptop internal keyboard on Linux"
arch=('any')
url="https://github.com/miflow13/KeyFlip-"
license=('MIT')
depends=('gtk4' 'python' 'python-gobject' 'polkit' 'util-linux' 'systemd' 'libcanberra' 'glib2' 'gnome-shell')
conflicts=('keyflip-core' 'gnome-shell-extension-keyflip')
replaces=('keyflip-core' 'gnome-shell-extension-keyflip')
# Build this archive with make package and copy it next to the PKGBUILD.
source=("keyflip-${pkgver//_/-}.tar.gz")
sha256sums=('8f93b16fa658145c93c05b8a904f168df5e0f18f2fea9a781d942555eed4c800')

prepare() {
    local source_dir="$srcdir/keyflip-0.2.0-beta"
    sed -i 's|Exec=/usr/local/bin/keyflip|Exec=keyflip|' \
        "$source_dir/packaging/io.github.miflow13.KeyFlip.desktop"
}

package() {
    local source_dir="$srcdir/keyflip-0.2.0-beta"

    install -Dm755 "$source_dir/keyflip-helper" \
        "$pkgdir/usr/libexec/keyflip/keyflip-helper"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.policy" \
        "$pkgdir/usr/share/polkit-1/actions/io.github.miflow13.KeyFlip.policy"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.gschema.xml" \
        "$pkgdir/usr/share/glib-2.0/schemas/io.github.miflow13.KeyFlip.gschema.xml"
    install -Dm644 "$source_dir/assets/sounds/toggle-on.ogg" \
        "$pkgdir/usr/share/keyflip/sounds/toggle-on.ogg"
    install -Dm644 "$source_dir/assets/sounds/toggle-off.ogg" \
        "$pkgdir/usr/share/keyflip/sounds/toggle-off.ogg"
    install -Dm644 "$source_dir/README.md" \
        "$pkgdir/usr/share/doc/keyflip/README.md"
    install -Dm644 "$source_dir/LICENSE" \
        "$pkgdir/usr/share/licenses/keyflip/LICENSE"
    install -Dm644 "$source_dir/app.py" "$pkgdir/usr/libexec/keyflip/app.py"
    install -Dm644 "$source_dir/keyflip_app.py" \
        "$pkgdir/usr/libexec/keyflip/keyflip_app.py"
    install -Dm755 "$source_dir/keyflip" "$pkgdir/usr/bin/keyflip"
    install -Dm644 "$source_dir/assets/keyflip.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.miflow13.KeyFlip.png"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.desktop" \
        "$pkgdir/usr/share/applications/io.github.miflow13.KeyFlip.desktop"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.miflow13.KeyFlip.metainfo.xml"
    local extension_dir="$pkgdir/usr/share/gnome-shell/extensions/keyflip@miflow13.github.io"

    install -d "$extension_dir"
    install -m644 "$source_dir/gnome-extension/extension.js" \
        "$source_dir/gnome-extension/metadata.json" \
        "$source_dir/gnome-extension/stylesheet.css" \
        "$source_dir/gnome-extension/"*.svg "$extension_dir/"
}
