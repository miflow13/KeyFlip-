# Maintainer: Miflow13 <pizzafan513 at gmail dot com>
pkgname=keyflip
pkgver=0.1.0_beta
pkgrel=1
pkgdesc="Toggle a supported laptop internal keyboard on Linux"
arch=('any')
url="https://github.com/miflow13/fedora-internal-keyboard-toggler"
license=('custom:proprietary')
depends=('gtk4' 'python' 'python-gobject' 'polkit' 'util-linux' 'systemd' 'libcanberra')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v0.1.0-beta.tar.gz")
sha256sums=('387b9c741298f50fd2df079130487e456c4e190cce4fecc2ccd45fb15628a158')

package() {
    local source_dir="$srcdir/fedora-internal-keyboard-toggler-0.1.0-beta"

    sed -i 's|/usr/local/lib/keyflip/app.py|/usr/lib/keyflip/app.py|' "$source_dir/keyflip"
    sed -i 's|Exec=/usr/local/bin/keyflip|Exec=keyflip|' \
        "$source_dir/packaging/io.github.miflow13.KeyFlip.desktop"

    install -Dm644 "$source_dir/app.py" "$pkgdir/usr/lib/keyflip/app.py"
    install -Dm644 "$source_dir/keyflip_app.py" "$pkgdir/usr/lib/keyflip/keyflip_app.py"
    install -Dm755 "$source_dir/keyflip-helper" "$pkgdir/usr/lib/keyflip/keyflip-helper"
    install -Dm755 "$source_dir/keyflip" "$pkgdir/usr/bin/keyflip"
    install -Dm644 "$source_dir/assets/keyflip.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.miflow13.KeyFlip.png"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.desktop" \
        "$pkgdir/usr/share/applications/io.github.miflow13.KeyFlip.desktop"
    install -Dm644 "$source_dir/packaging/io.github.miflow13.KeyFlip.metainfo.xml" \
        "$pkgdir/usr/share/metainfo/io.github.miflow13.KeyFlip.metainfo.xml"
    install -Dm644 "$source_dir/README.md" "$pkgdir/usr/share/doc/keyflip/README.md"
}
