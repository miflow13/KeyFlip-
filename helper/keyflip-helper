#!/usr/bin/env bash
# KeyFlip: toggle a standard i8042/AT internal keyboard on Fedora GNOME.
# No persistent configuration changes. A reboot restores normal operation.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

helper_dir=$(dirname -- "$(readlink -f -- "$0")")
if [[ -d $helper_dir/keyflip ]]; then
    module_dir=$helper_dir/keyflip
else
    module_dir=$(readlink -f -- "$helper_dir/../src/keyflip")
fi

usage() {
    echo 'Usage: sudo keyflip-helper {toggle|enable|disable|test|status|external-status|external-list|clean}'
    echo 'test disables for about 15 seconds, then automatically enables.'
}
action=${1:-toggle}
case "$action" in
    toggle|enable|disable|test|status|external-status|external-list|clean) ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }

if [[ $action == clean ]]; then
    exec /usr/bin/python3 -I "$module_dir/cleaning.py"
fi

# This query is intentionally unprivileged so the desktop extension can watch
# for hot-plugged keyboards without producing authentication prompts merely to
# inspect input devices. udev identifies real keyboard devices and their bus.
if [[ $action == external-status || $action == external-list ]]; then
    if ! output=$(/usr/bin/python3 -I "$module_dir/state.py" --external); then
        echo "$output" >&2
        exit 1
    fi
    if [[ $action == external-list ]]; then
        [[ -z $output ]] || printf '%s\n' "$output"
    elif [[ -n $output ]]; then
        echo 'External keyboard: connected'
    else
        echo 'External keyboard: disconnected'
    fi
    exit 0
fi

# The port description survives unbinding; do not guess from event numbers.
ports=()
for port in /sys/bus/serio/devices/serio*; do
    [[ -r "$port/description" ]] || continue
    [[ $(<"$port/description") == 'i8042 KBD port' ]] && ports+=("$port")
done
if [[ ${#ports[@]} -ne 1 ]]; then
    echo 'No single supported i8042 internal keyboard found. Nothing changed.' >&2
    echo 'This script does not support internal USB or I2C keyboards.' >&2
    exit 1
fi
port=${ports[0]}
id=${port##*/}
[[ $id =~ ^serio[0-9]+$ ]] || exit 1
driver=/sys/bus/serio/drivers/atkbd
state=disabled
if [[ -L "$port/driver" ]]; then
    if [[ $(readlink -f "$port/driver") != "$driver" ]]; then
        echo 'Keyboard port is using an unexpected driver. Nothing changed.' >&2
        exit 1
    fi
    state=enabled
fi
if [[ $action == status ]]; then
    echo "Internal keyboard: $state ($id)"
    exit 0
fi
if [[ $EUID -ne 0 ]]; then
    echo "Run with sudo: sudo bash \"$0\" $action" >&2
    exit 1
fi
[[ -w "$driver/bind" && -w "$driver/unbind" ]] || {
    echo 'Keyboard driver controls are unavailable. Nothing changed.' >&2
    exit 1
}
[[ -w "$port/bind_mode" ]] || {
    echo 'Keyboard port binding control is unavailable. Nothing changed.' >&2
    exit 1
}
# Serialize changes, including the automatic restore.
exec 9>/run/internal-keyboard-toggle.lock
flock -xn 9 || { echo 'Another keyboard change or Cleaning Mode is active.' >&2; exit 1; }
# Refresh state after acquiring the lock.
if [[ -L "$port/driver" ]]; then state=enabled; else state=disabled; fi
if [[ $action == toggle ]]; then
    if [[ $state == enabled ]]; then action=disable; else action=enable; fi
fi
if [[ $action == test ]]; then
    [[ $state == enabled ]] || { echo 'Enable the keyboard before testing.'; exit 1; }
    # Schedule recovery before disabling. The job survives a closed terminal.
    systemd-run --quiet --collect --on-active=15s --timer-property=AccuracySec=1s \
        /bin/bash -c 'exec 9>/run/internal-keyboard-toggle.lock; flock -x 9; port=/sys/bus/serio/devices/$1; printf auto > "$port/bind_mode"; if [[ ! -L $port/driver ]]; then printf "%s" "$1" > /sys/bus/serio/drivers/atkbd/bind; fi' \
        keyboard-restore "$id"
    printf manual > "$port/bind_mode"
    printf '%s' "$id" > "$driver/unbind"
    echo 'Internal keyboard disabled. Automatic restore in about 15 seconds.'
elif [[ $action == disable ]]; then
    recovery_uid=${PKEXEC_UID:-${SUDO_UID:-0}}
    [[ $recovery_uid =~ ^[0-9]+$ ]] || { echo 'Invalid recovery user.' >&2; exit 1; }
    /usr/bin/python3 -I "$module_dir/recovery.py" arm "$recovery_uid" "$id"
    printf manual > "$port/bind_mode"
    [[ $state == disabled ]] || printf '%s' "$id" > "$driver/unbind"
    [[ ! -L "$port/driver" ]] || { echo 'The internal keyboard could not be confirmed disabled.' >&2; exit 1; }
    echo 'Internal keyboard disabled. Recovery is active while KeyFlip runs.'
else
    printf auto > "$port/bind_mode"
    # Changing back to auto normally binds atkbd synchronously. Explicitly bind
    # only when the kernel has not done so, since bind fails in manual mode.
    [[ -L "$port/driver" ]] || printf '%s' "$id" > "$driver/bind"
    [[ -L "$port/driver" && $(readlink -f "$port/driver") == "$driver" ]] || {
        echo 'The internal keyboard could not be confirmed enabled.' >&2
        exit 1
    }
    /usr/bin/python3 -I "$module_dir/recovery.py" disarm
    echo 'Internal keyboard enabled.'
fi
